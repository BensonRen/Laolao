{
  "name": "laolao",
  "version": "0.2.0",
  "description": "Real-time speech captions for video calls — 老老",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:win:dir": "electron-builder --win --target dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.laolao.app",
    "productName": "Laolao",
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Laolao listens to your microphone to generate real-time captions.",
        "NSCameraUsageDescription": "Laolao shows your camera feed in the caption overlay."
      }
    },
    "icon": "icon.icns",
    "directories": {
      "output": "../dist"
    },
    "extraResources": [
      { "from": "resources/", "to": "resources/", "filter": ["**/*"] }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] },
        { "target": "portable", "arch": ["x64", "arm64"] }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Laolao"
    }
  }
}

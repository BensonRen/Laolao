{
  "name": "laolao",
  "version": "0.1.0",
  "description": "Real-time speech captions for video calls — 老老",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.laolao.app",
    "productName": "Laolao",
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg",
      "icon": "icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Laolao listens to your microphone to generate real-time captions.",
        "NSCameraUsageDescription": "Laolao shows your camera feed in the caption overlay."
      }
    },
    "icon": "icon.icns",
    "directories": {
      "output": "../dist"
    },
    "extraResources": [
      { "from": "resources/", "to": "resources/", "filter": ["**/*"] }
    ],
    "win": {
      "target": "dir",
      "icon": "icon.ico"
    }
  }
}
